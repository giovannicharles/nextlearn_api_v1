# Server
PORT=5000
NODE_ENV=production

# MongoDB (MONGO_URI ou MONGODB_URI — les deux sont acceptés)
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/nextlearnDB?retryWrites=true&w=majority

# Redis (optionnel - pour cache et queues)
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=tonSuperSecretKey
JWT_EXPIRES_IN=7d

# Cloudinary (stockage fichiers PDF)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email — SendGrid (si API key) ou SMTP Gmail (auto-détecté)
# SENDGRID_API_KEY=your_sendgrid_api_key
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
OTP_RATE_LIMIT_MAX=5

# Upload
MAX_FILE_SIZE=52428800
